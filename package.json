{
  "name": "dsh-voice-enter-send",
  "version": "1.0.0",
  "description": "Enter ends voice dictation in DeepSeek Harness: the transcript lands in the composer and sending stays on the ordinary Enter.",
  "type": "module",
  "license": "MIT",
  "icon": "./icon.svg",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "voice-input",
    "dictation",
    "speech-to-text"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "client.js",
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/voice-enter-send.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
