{
  "name": "dsh-voice-enter-send",
  "version": "1.1.0",
  "description": "Voice dictation helpers for DeepSeek Harness: Enter ends the capture, and recording survives switching windows.",
  "type": "module",
  "license": "MIT",
  "icon": "./icon.svg",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "voice-input",
    "dictation",
    "speech-to-text"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "client.js",
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/voice-enter-send.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nestormedia/dsh-voice-enter-send.git"
  },
  "homepage": "https://github.com/nestormedia/dsh-voice-enter-send#readme",
  "bugs": {
    "url": "https://github.com/nestormedia/dsh-voice-enter-send/issues"
  }
}
